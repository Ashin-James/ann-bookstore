# ==============================================================================
# Ann's Bookstore Environment Configuration (.env.example)
# Copy this file to .env.local for local development.
# ==============================================================================

# Demo Mode: When true, operates with in-browser mocked seed data without external keys.
NEXT_PUBLIC_DEMO_MODE=true

# Demo Mode Admin Credentials (SERVER ONLY - Never expose to client/browser!)
# When set in .env.local, you can sign in to /admin/login with these credentials.
ADMIN_DEMO_EMAIL=
ADMIN_DEMO_PASSWORD=

# Admin Feature Flag: When false or unset, /admin returns a 404 Not Found.
ADMIN_ENABLED=false

# Admin Session HMAC Secret (SERVER ONLY - Web Crypto signature)
SESSION_SECRET=

# Supabase Free Stack Configuration
# Public URL and Anonymous Key accessible by browser & server
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (SERVER ONLY - Never expose to client/browser!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Setup Secret: Required once to initialize the first owner account at /admin/setup
SETUP_SECRET=replace_with_secure_random_setup_token_min_32_chars

# Resend API Key (Optional): Free tier email service.
# When empty or in demo mode, links are logged and displayed directly on screen.
RESEND_API_KEY=

# Salt for cryptographic hashing of IP addresses in audit logs and login attempts
IP_HASH_SALT=replace_with_random_salt_for_ip_hashing_min_32_chars
